# Pegasus Phantom Menace v2 - Environment Configuration
# Copy this file to .env and edit as needed

# Application
PEGASUS__APP__DEBUG=false
PEGASUS__APP__WORKSPACE=/home/user/.pegasus

# Database
PEGASUS__DATABASE__TYPE=sqlite
PEGASUS__DATABASE__PATH=/home/user/.pegasus/pegasus.db
PEGASUS__DATABASE__ECHO=false

# Metasploit RPC
PEGASUS__METASPLOIT__RPC_HOST=127.0.0.1
PEGASUS__METASPLOIT__RPC_PORT=55553
PEGASUS__METASPLOIT__RPC_PASSWORD=msf123
PEGASUS__METASPLOIT__RPC_SSL=false
PEGASUS__METASPLOIT__AUTO_START=false

# Frida
PEGASUS__FRIDA__ENABLED=true
PEGASUS__FRIDA__SCRIPTS_DIR=/home/user/.pegasus/frida_scripts

# AI (Anthropic Claude)
PEGASUS__AI__PROVIDER=anthropic
PEGASUS__AI__MODEL=claude-sonnet-4-6
PEGASUS__AI__API_KEY=sk-ant-your-key-here
PEGASUS__AI__MAX_TOKENS=2048
PEGASUS__AI__TEMPERATURE=0.7

# Network
PEGASUS__NETWORK__DEFAULT_INTERFACE=auto
PEGASUS__NETWORK__NMAP_PATH=nmap
PEGASUS__NETWORK__DEFAULT_TIMEOUT=120

# Reporting
PEGASUS__REPORTING__DEFAULT_FORMAT=html
PEGASUS__REPORTING__OUTPUT_DIR=/home/user/.pegasus/reports
PEGASUS__REPORTING__THEME=dark

# Security
PEGASUS__SECURITY__JWT_SECRET=change-me-in-production
PEGASUS__SECURITY__JWT_EXPIRY_HOURS=24
PEGASUS__SECURITY__BCRYPT_ROUNDS=12
PEGASUS__SECURITY__API_RATE_LIMIT=100
PEGASUS__SECURITY__ENABLE_2FA=false

# Telemetry
PEGASUS__TELEMETRY__ENABLED=false
PEGASUS__TELEMETRY__ENDPOINT=

# Plugins
PEGASUS__PLUGINS__ENABLED=core
PEGASUS__PLUGINS__AUTO_LOAD=true